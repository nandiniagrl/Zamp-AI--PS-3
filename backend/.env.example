# Copy to backend/.env and fill in. NEVER commit backend/.env.
APP_ENV=local

# Groq (Phase 1) - free key from console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Tavily (Phase 2) - free key from app.tavily.com
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

CACHE_ENABLED=true

# Persistence (Phase 10/13): memory | sqlite | firestore   /  memory | sqlite | postgres
STORAGE_BACKEND=memory
CHECKPOINT_BACKEND=sqlite
DATABASE_URL=
GCP_PROJECT=

CORS_ORIGINS=http://localhost:3000
